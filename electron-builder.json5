{
  appId: "com.dritsolutions.dupefinder",
  productName: "Duplicate Photo Finder",
  copyright: "Copyright © 2025 DritSolutions",
  directories: {
    output: "release"
  },
  files: [
    "dist",
    "dist-electron"
  ],
  publish: {
    provider: "github",
    owner: "dritsolutions",
    repo: "duplicate-photo-finder"
  },
  win: {
    target: [
      {
        target: "nsis",
        arch: ["x64"]
      }
    ]
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "Duplicate Photo Finder"
  }
}